<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_attendance_overtime" model="ir.actions.report"><field name="name">Overtime Report</field><field name="model">attendance.overtime</field><field name="report_type">qweb-pdf</field><field name="report_name">attendance_overtime.report_attendance_overtime_document</field><field name="report_file">attendance_overtime.report_attendance_overtime_document</field><field name="binding_model_id" ref="model_attendance_overtime"/><field name="binding_type">report</field><field name="paperformat_id" ref="base.paperformat_euro"/></record>
    <template id="report_attendance_overtime_document">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="overtime"><t t-call="web.external_layout"><div class="page"><h2>Attendance Overtime</h2><table class="table table-sm"><tr><th>Reference</th><td><span t-field="overtime.name"/></td><th>Date</th><td><span t-field="overtime.date"/></td></tr><tr><th>Employee</th><td><span t-field="overtime.employee_id"/></td><th>Department</th><td><span t-field="overtime.department_id"/></td></tr><tr><th>Expected</th><td><span t-field="overtime.expected_hours"/> h</td><th>Worked</th><td><span t-field="overtime.worked_hours"/> h</td></tr><tr><th>Calculated Overtime</th><td><span t-field="overtime.overtime_hours"/> h</td><th>Approved Overtime</th><td><span t-field="overtime.approved_overtime_hours"/> h</td></tr><tr><th>Hourly Rate</th><td><span t-field="overtime.hourly_rate"/></td><th>Multiplier</th><td><span t-field="overtime.multiplier"/></td></tr><tr><th>Overtime Amount</th><td colspan="3"><strong><span t-field="overtime.overtime_amount"/></strong></td></tr></table><h4 class="mt-4">Source Attendances</h4><table class="table table-sm table-bordered"><thead><tr><th>Check In</th><th>Check Out</th><th>Worked Hours</th></tr></thead><tbody><tr t-foreach="overtime.attendance_ids" t-as="attendance"><td><span t-field="attendance.check_in"/></td><td><span t-field="attendance.check_out"/></td><td><span t-field="attendance.worked_hours"/></td></tr></tbody></table></div></t></t></t>
    </template>
</odoo>
