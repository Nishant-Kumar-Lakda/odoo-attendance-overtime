<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_overtime_list" model="ir.ui.view">
        <field name="name">attendance.overtime.list</field><field name="model">attendance.overtime</field>
        <field name="arch" type="xml">
            <list string="Attendance Overtime" create="0" decoration-info="state == 'submitted'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                <field name="name"/><field name="date"/><field name="employee_id"/><field name="department_id" optional="show"/><field name="overtime_type" optional="show"/><field name="expected_hours" optional="show"/><field name="worked_hours" optional="show"/><field name="overtime_hours"/><field name="approved_overtime_hours"/><field name="hourly_rate" optional="hide"/><field name="multiplier" optional="hide"/><field name="overtime_amount" sum="Total"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_attendance_overtime_kanban" model="ir.ui.view">
        <field name="name">attendance.overtime.kanban</field><field name="model">attendance.overtime</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="employee_id"/><field name="date"/><field name="overtime_hours"/><field name="approved_overtime_hours"/><field name="overtime_amount"/><field name="state"/>
                <templates><t t-name="card"><div class="oe_kanban_global_click"><div class="d-flex justify-content-between align-items-start"><strong><field name="employee_id"/></strong><field name="overtime_hours"/> h</div><div class="text-muted"><field name="date"/></div><div class="mt-2"><span>Approved: </span><strong><field name="approved_overtime_hours"/> h</strong></div><div class="mt-1"><span>Amount: </span><strong><field name="overtime_amount" widget="monetary"/></strong></div></div></t></templates>
            </kanban>
        </field>
    </record>
    <record id="view_attendance_overtime_form" model="ir.ui.view">
        <field name="name">attendance.overtime.form</field><field name="model">attendance.overtime</field>
        <field name="arch" type="xml">
            <form string="Attendance Overtime">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" groups="attendance_overtime.group_attendance_overtime_manager" invisible="state != 'submitted'"/>
                    <button name="action_reject" type="object" string="Reject" groups="attendance_overtime.group_attendance_overtime_manager" invisible="state != 'submitted'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" groups="attendance_overtime.group_attendance_overtime_manager" invisible="state not in ('approved','rejected')"/>
                    <button name="action_export_payroll_csv" type="object" string="Export Payroll CSV" groups="attendance_overtime.group_attendance_overtime_manager" invisible="state != 'approved'" icon="fa-download"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
                </header>
                <sheet><div class="oe_button_box" name="button_box"/><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group><group string="Attendance"><field name="employee_id" readonly="state != 'draft'"/><field name="department_id"/><field name="date" readonly="state != 'draft'"/><field name="attendance_ids" widget="many2many_tags"/><field name="first_check_in"/><field name="last_check_out"/></group>
                    <group string="Overtime"><field name="overtime_type"/><field name="expected_hours"/><field name="worked_hours"/><field name="overtime_hours"/><field name="approved_overtime_hours" readonly="state in ('approved','rejected')"/><field name="hourly_rate"/><field name="multiplier"/><field name="overtime_amount"/></group></group>
                    <group string="Processing"><field name="rule_id"/><field name="company_id" groups="base.group_multi_company"/><field name="export_reference"/></group>
                    <notebook><page string="Rejection" invisible="state != 'rejected'"><field name="rejection_reason" readonly="1"/></page><page string="Source Attendances"><field name="attendance_ids" nolabel="1" readonly="1"><list><field name="employee_id"/><field name="check_in"/><field name="check_out"/><field name="worked_hours"/></list></field></page></notebook>
                </sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="view_attendance_overtime_search" model="ir.ui.view">
        <field name="name">attendance.overtime.search</field><field name="model">attendance.overtime</field>
        <field name="arch" type="xml"><search string="Attendance Overtime"><field name="employee_id"/><field name="department_id"/><field name="date"/><field name="state"/><field name="overtime_type"/><separator/><filter name="submitted" string="To Approve" domain="[('state','=','submitted')]"/><filter name="approved" string="Approved" domain="[('state','=','approved')]"/><filter name="rejected" string="Rejected" domain="[('state','=','rejected')]"/><separator/><group string="Group By"><filter name="group_employee" string="Employee" context="{'group_by':'employee_id'}"/><filter name="group_department" string="Department" context="{'group_by':'department_id'}"/><filter name="group_month" string="Month" context="{'group_by':'date:month'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/></group></search>
        </field>
    </record>
    <record id="action_attendance_overtime" model="ir.actions.act_window"><field name="name">Attendance Overtime</field><field name="res_model">attendance.overtime</field><field name="view_mode">list,kanban,form,pivot,graph</field><field name="search_view_id" ref="view_attendance_overtime_search"/></record>
    <menuitem id="menu_attendance_overtime" name="Overtime" parent="hr_attendance.menu_hr_attendance_root" action="action_attendance_overtime" sequence="25" groups="attendance_overtime.group_attendance_overtime_user"/>
</odoo>
