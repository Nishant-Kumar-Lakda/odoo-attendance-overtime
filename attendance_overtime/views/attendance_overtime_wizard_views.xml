<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_overtime_generate_wizard" model="ir.ui.view"><field name="name">attendance.overtime.generate.wizard.form</field><field name="model">attendance.overtime.generate.wizard</field><field name="arch" type="xml"><form string="Generate Overtime"><sheet><group><field name="date_from"/><field name="date_to"/><field name="company_id" groups="base.group_multi_company"/></group><field name="employee_ids" widget="many2many_tags" options="{'no_create': True}"/><p class="text-muted mt16">Leave Employees empty to process all active employees in the selected company.</p></sheet><footer><button name="action_generate" type="object" string="Generate" class="btn-primary"/><button special="cancel" string="Cancel" class="btn-secondary"/></footer></form></field></record>
    <record id="action_attendance_overtime_generate" model="ir.actions.act_window"><field name="name">Generate Overtime</field><field name="res_model">attendance.overtime.generate.wizard</field><field name="view_mode">form</field><field name="target">new</field></record>
    <menuitem id="menu_attendance_overtime_generate" name="Generate Overtime" parent="hr_attendance.menu_hr_attendance_root" action="action_attendance_overtime_generate" sequence="20" groups="attendance_overtime.group_attendance_overtime_user"/>
    <record id="view_attendance_overtime_reject_wizard" model="ir.ui.view"><field name="name">attendance.overtime.reject.wizard.form</field><field name="model">attendance.overtime.reject.wizard</field><field name="arch" type="xml"><form string="Reject Overtime"><group><field name="reason" placeholder="Explain why this overtime is rejected..."/></group><footer><button name="action_reject" type="object" string="Reject" class="btn-primary"/><button special="cancel" string="Cancel" class="btn-secondary"/></footer></form></field></record>
</odoo>
