<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_attendance_overtime" model="ir.module.category">
        <field name="name">Attendance Overtime</field>
        <field name="description">Attendance overtime calculation and approval.</field>
        <field name="sequence">25</field>
    </record>
    <record id="group_attendance_overtime_user" model="res.groups">
        <field name="name">Overtime User</field>
        <field name="category_id" ref="module_category_attendance_overtime"/>
        <field name="implied_ids" eval="[(4, ref('hr_attendance.group_hr_attendance_officer')), (4, ref('hr.group_hr_user'))]"/>
    </record>
    <record id="group_attendance_overtime_manager" model="res.groups">
        <field name="name">Overtime Manager</field>
        <field name="category_id" ref="module_category_attendance_overtime"/>
        <field name="implied_ids" eval="[(4, ref('attendance_overtime.group_attendance_overtime_user')), (4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
    </record>
    <record id="rule_attendance_overtime_company_user" model="ir.rule">
        <field name="name">Overtime company access</field>
        <field name="model_id" ref="model_attendance_overtime"/>
        <field name="groups" eval="[(4, ref('attendance_overtime.group_attendance_overtime_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_attendance_overtime_manager_all" model="ir.rule">
        <field name="name">Overtime manager all records</field>
        <field name="model_id" ref="model_attendance_overtime"/>
        <field name="groups" eval="[(4, ref('attendance_overtime.group_attendance_overtime_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
